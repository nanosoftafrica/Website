# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.
PORT=3000

# Database (the db container is created with these)
POSTGRES_DB=nanosoft
POSTGRES_USER=nanosoft
POSTGRES_PASSWORD=

# Sign-in tokens: a long random string, 32+ characters
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin login, created on the first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SITE_URL=https://ntlafrica.com
APP_URL=https://ntlafrica.com

# Optional: email for demo requests
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
NOTIFY_EMAIL=
NOTIFY_PHONE=

# Optional: field docs app
FIELD_DOCS_ADMIN_EMAIL=
FIELD_DOCS_ADMIN_PASSWORD=
FIELD_DOCS_SESSION_SECRET=

# Optional: analytics (baked in at build time)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=